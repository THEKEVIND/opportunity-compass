# Strands uses Amazon Bedrock by default. Configure AWS credentials by one of
# the methods documented at https://strandsagents.com/docs/user-guide/quickstart/python/
AWS_REGION=us-west-2
OPPORTUNITY_COMPASS_PROVIDER=bedrock
OPPORTUNITY_COMPASS_MODEL=global.anthropic.claude-sonnet-4-6

# Zero-cost local alternative (requires a running Ollama server and pulled model):
# OPPORTUNITY_COMPASS_PROVIDER=ollama
# OPPORTUNITY_COMPASS_MODEL=qwen3:4b
# OLLAMA_HOST=http://localhost:11434
